# Local smoke (matches prisma/schema.prisma sqlite provider):
DATABASE_URL="file:./dev.db"
# Docker / production Postgres (also set provider=\"postgresql\" — see docs/deploy.md):
# DATABASE_URL="postgresql://mutesound:mutesound_dev_pass_123@localhost:5432/mutesound?schema=public"

JWT_SECRET="replace_me_with_user_provided_jwt_secret"
JWT_REFRESH_SECRET="replace_me_with_user_provided_jwt_refresh_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000
API_PREFIX=v1

ALADHAN_API_BASE="https://api.aladhan.com/v1"
ALADHAN_DEFAULT_COUNTRY="Bangladesh"

GOOGLE_OAUTH_CLIENT_ID="replace_me_with_user_provided_google_client_id"

# Firebase Admin (FCM). Leave unset for local no-op push. See docs/firebase.md.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste private key with literal \n escapes, e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""
# Optional alternative to the three vars above (path to service-account JSON, not committed):
# GOOGLE_APPLICATION_CREDENTIALS=""

# Deprecated — unused by firebase-admin; kept only for older docs/scripts.
# FCM_SERVER_KEY=""

CORS_ORIGINS="http://localhost:3001,chrome-extension://*"

NODE_ENV="development"
