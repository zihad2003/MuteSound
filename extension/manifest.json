{
  "manifest_version": 3,
  "name": "MuteSound",
  "description": "Automatically mute audible tabs during Azan prayer times. Always shows Undo.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MuteSound"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "alarms", "storage", "notifications"],
  "host_permissions": ["http://localhost:3000/*", "https://api.mutesound.app/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
