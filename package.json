{
  "name": "mutesound",
  "private": true,
  "version": "0.1.0",
  "description": "MuteSound monorepo — auto-mute audio during Azan prayer times",
  "scripts": {
    "dev:backend": "pnpm --filter @mutesound/backend start:dev",
    "dev:web": "pnpm --filter @mutesound/web dev",
    "build:backend": "pnpm --filter @mutesound/backend build",
    "build:web": "pnpm --filter @mutesound/web build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
